{
  "datasets": [
    {
      "name": "774cb7d0",
      "displayName": "crop_year_trends",
      "queryLines": [
        "SELECT\r\n",
        "    year,\r\n",
        "    crop_name,\r\n",
        "    country_count,\r\n",
        "    total_production,\r\n",
        "    total_area_harvested,\r\n",
        "    production_per_harvested_area,\r\n",
        "    avg_reported_yield\r\n",
        "FROM agg_crop_year\r\n",
        "ORDER BY year, crop_name;"
      ]
    },
    {
      "name": "ec421bb0",
      "displayName": "country_production",
      "queryLines": [
        "SELECT\r\n",
        "    c.country_name,\r\n",
        "    c.region,\r\n",
        "    c.subregion,\r\n",
        "    cr.crop_name,\r\n",
        "    f.year_key AS year,\r\n",
        "    SUM(f.production_quantity) AS total_production,\r\n",
        "    SUM(f.area_harvested) AS total_area_harvested\r\n",
        "FROM fact_agri_environment f\r\n",
        "JOIN dim_country c\r\n",
        "    ON f.country_key = c.country_code\r\n",
        "JOIN dim_crop cr\r\n",
        "    ON f.crop_key = cr.crop_key\r\n",
        "GROUP BY\r\n",
        "    c.country_name,\r\n",
        "    c.region,\r\n",
        "    c.subregion,\r\n",
        "    cr.crop_name,\r\n",
        "    f.year_key;"
      ]
    },
    {
      "name": "64b57250",
      "displayName": "top_10",
      "queryLines": [
        "SELECT\r\n",
        "    country_name,\r\n",
        "    SUM(total_production) AS total_production\r\n",
        "FROM agg_country_year\r\n",
        "WHERE year BETWEEN 2018 AND 2022\r\n",
        "GROUP BY country_name\r\n",
        "ORDER BY total_production DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "1be25f9f",
      "displayName": "environment_trends",
      "queryLines": [
        "SELECT\r\n",
        "    country_name,\r\n",
        "    region,\r\n",
        "    year,\r\n",
        "    forest_area,\r\n",
        "    agricultural_land,\r\n",
        "    freshwater_per_capita,\r\n",
        "    freshwater_withdrawals\r\n",
        "FROM agg_country_year\r\n",
        "WHERE year BETWEEN 1990 AND 2022\r\n",
        "ORDER BY country_name, year;"
      ]
    },
    {
      "name": "063a148a",
      "displayName": "agriculture_kpis",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(DISTINCT country_key) AS total_countries,\r\n",
        "    COUNT(DISTINCT crop_key) AS total_crops,\r\n",
        "    COUNT(*) AS total_records,\r\n",
        "    SUM(production_quantity) AS total_production,\r\n",
        "    SUM(area_harvested) AS total_harvested_area\r\n",
        "FROM fact_agri_environment;"
      ]
    },
    {
      "name": "06931199",
      "displayName": "production_map",
      "queryLines": [
        "SELECT country_name, total_production\r\n",
        "FROM agg_country_year\r\n",
        "WHERE year = 2022\r\n",
        "  AND total_production IS NOT NULL"
      ]
    }
  ],
